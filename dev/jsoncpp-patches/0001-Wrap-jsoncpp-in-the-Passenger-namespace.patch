From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tinco Andringa <tinco@phusion.nl>
Date: Fri, 20 Nov 2026 16:16:10 +0000
Subject: [PATCH 1/4] Wrap jsoncpp in the Passenger namespace

On Nginx, Passenger and Google PageSpeed are linked into the same
executable, and both bundle jsoncpp. Namespacing avoids duplicate symbol
collisions (see commit cfcf562ef).
---
 json-forwards.h |  7 ++++++-
 json.h          | 24 +++++++++++++++++++-----
 jsoncpp.cpp     | 14 ++++++++++++++
 3 files changed, 39 insertions(+), 6 deletions(-)

diff --git a/json-forwards.h b/json-forwards.h
index dbad44e..f1defe2 100644
--- a/json-forwards.h
+++ b/json-forwards.h
@@ -139,6 +139,7 @@ license you like.
 #pragma pack(push)
 #pragma pack()

+namespace Passenger {
 namespace Json {
 template <typename T> class SecureAllocator {
 public:
@@ -220,7 +221,7 @@ bool operator!=(const SecureAllocator<T>&, const SecureAllocator<U>&) {
 }

 } // namespace Json
-
+} // namespace Passenger
 #pragma pack(pop)

 #endif // JSON_ALLOCATOR_H_INCLUDED
@@ -344,6 +345,7 @@ extern JSON_API int msvc_pre1900_c99_snprintf(char* outBuf, size_t size,

 #endif // if !defined(JSON_IS_AMALGAMATION)

+namespace Passenger {
 namespace Json {
 JSON_API const char* version();
 using Int = int;
@@ -382,6 +384,7 @@ using OStringStream =
 using IStream = std::istream;
 using OStream = std::ostream;
 } // namespace Json
+} // namespace Passenger

 // Legacy names (formerly macros).
 using JSONCPP_STRING = Json::String;
@@ -417,6 +420,7 @@ using JSONCPP_OSTREAM = Json::OStream;
 #include "config.h"
 #endif // if !defined(JSON_IS_AMALGAMATION)

+namespace Passenger {
 namespace Json {

 // writer.h
@@ -448,6 +452,7 @@ class ValueMembersView;
 class ValueConstMembersView;

 } // namespace Json
+} // namespace Passenger

 #endif // JSON_FORWARDS_H_INCLUDED

