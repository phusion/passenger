# Apache configuration for the WebSocket demo. @PLACEHOLDERS@ are substituted
# by dev/e2e/apache-websocket/run-websocket-demo.
#
# This is deliberately a plain, readable mod_passenger setup: no proxying, no
# second application server, no separate port for WebSocket traffic.

ServerRoot /etc/httpd
Listen 127.0.0.1:@PORT@
PidFile @WORKDIR@/httpd.pid
ErrorLog @WORKDIR@/error.log
LogLevel info
ServerName localhost

LoadModule mpm_event_module modules/mod_mpm_event.so
LoadModule authz_core_module modules/mod_authz_core.so
LoadModule unixd_module modules/mod_unixd.so
LoadModule mime_module modules/mod_mime.so
LoadModule dir_module modules/mod_dir.so
LoadModule log_config_module modules/mod_log_config.so
LoadModule reqtimeout_module modules/mod_reqtimeout.so
LoadModule socache_shmcb_module modules/mod_socache_shmcb.so
LoadModule ssl_module modules/mod_ssl.so
LoadModule passenger_module @PASSENGER_ROOT@/buildout/apache2/mod_passenger.so

TypesConfig /etc/mime.types

PassengerRoot @PASSENGER_ROOT@
PassengerDefaultRuby /usr/bin/ruby
PassengerInstanceRegistryDir @WORKDIR@
PassengerDataBufferDir @WORKDIR@
PassengerLogLevel 3

# mod_reqtimeout is loaded on purpose, with a deadline shorter than the idle
# period the client takes, so that the demo runs with a realistic filter chain
# rather than a minimal one.
RequestReadTimeout header=5 body=2

<VirtualHost *:@PORT@>
  DocumentRoot @APPROOT@/public
  PassengerAppRoot @APPROOT@
  PassengerAppEnv production

  <Directory @APPROOT@/public>
    Require all granted
    Options -MultiViews
  </Directory>
</VirtualHost>

# The same application over TLS. This is the interesting one: the tunnel reads
# and writes the client side through the connection filter chain rather than
# the socket specifically so that mod_ssl still encrypts and decrypts, and
# mod_ssl hands over decrypted bytes a TLS record at a time in a way poll()
# cannot see.
Listen 127.0.0.1:@TLS_PORT@
SSLSessionCache shmcb:@WORKDIR@/ssl_scache(512000)

<VirtualHost *:@TLS_PORT@>
  DocumentRoot @APPROOT@/public
  PassengerAppRoot @APPROOT@
  PassengerAppEnv production

  SSLEngine on
  SSLCertificateFile @WORKDIR@/server.crt
  SSLCertificateKeyFile @WORKDIR@/server.key

  <Directory @APPROOT@/public>
    Require all granted
    Options -MultiViews
  </Directory>
</VirtualHost>
